# Every downloaded input of the bundle, pinned with its sha256. Change a pin only together with a
# Tier 1 + Tier 2 eval run (evals/README.md).

# Relocatable CPython (astral-sh/python-build-standalone), as lemonade-sdk/vllm-rocm bundles it.
PBS_TAG=20261026
PBS_ASSET=cpython-3.12.16+20261026-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PBS_SHA256=ce4f6d0a6cfdb3bed6e44c2f9affd85943c76a42e25ad3a259002f31d6fb8a20

# Pi coding agent (earendil-works/pi): standalone Linux build, no Node.js needed.
PI_VERSION=1.5.0
PI_ASSET=pi-linux-x64.tar.gz
PI_SHA256=df870ba0e344cb7b3358d8d8f19397b8b8d225a8669784736ad68a5c2169d53b

# Loom SDK. Its dist-info/loom.json names the hrx-loom-library revision that gets bundled.
HRX_LOOM_VERSION=0.1.0
